# syntax=docker/dockerfile:1.7
# Native Linux ARM64 / NVIDIA GB10 (DGX Spark) build.
# ---------- Stage 0: base build tools ----------
ARG CUDA_TAG=13.0.2-cudnn-devel-ubuntu24.04
ARG CUDA_RUNTIME_TAG=13.0.2-cudnn-runtime-ubuntu24.04
ARG CUDA_PACKAGE_VERSION=13-0
ARG CUMM_CUDA_VERSION=13.0
# GB10 reports SM 12.1; CUDA/PyTorch treat SM 12.0 cubins as binary-compatible.
# Building only this target keeps the native-extension build practical on Spark.
ARG CUDA_ARCH_LIST="12.0"
ARG TORCH_CUDA=cu130
ARG COMFY_CLI_VERSION=1.13.0

FROM nvidia/cuda:${CUDA_TAG} AS build-base

RUN test "$(uname -m)" = "aarch64"

ENV DEBIAN_FRONTEND=noninteractive PIP_PREFER_BINARY=1 CMAKE_BUILD_PARALLEL_LEVEL=8
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl wget git ninja-build \
    zlib1g-dev libssl-dev libbz2-dev libreadline-dev \
    sqlite3 libsqlite3-0 libsqlite3-dev libffi-dev liblzma-dev uuid-dev \
    libegl1-mesa-dev libgl1-mesa-dev libglvnd-dev libsm6 libxext6 libxrender1 \
    ffmpeg ca-certificates && \
    apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*

# ---------- Stage 1: build Python ----------
ARG PYTHON_VER=3.13.14
FROM build-base AS python-builder
WORKDIR /tmp/python
ADD https://www.python.org/ftp/python/${PYTHON_VER}/Python-${PYTHON_VER}.tgz .
RUN tar xzf Python-${PYTHON_VER}.tgz && cd Python-${PYTHON_VER} && \
    ./configure --enable-shared --enable-optimizations --enable-loadable-sqlite-extensions && \
    make -j$(nproc) && make install && ldconfig

RUN ln -sf /usr/local/bin/python3 /usr/local/bin/python && \
    ln -sf /usr/local/bin/pip3 /usr/local/bin/pip
# Keep only what we need noted; we'll copy from this later

# ---------- Stage 2: venv + core deps (torch, xformers, etc.) ----------
FROM nvidia/cuda:${CUDA_TAG} AS venv-builder
# Copy Python runtime from python-builder

RUN apt-get update && apt-get install -y --no-install-recommends curl wget git ca-certificates ninja-build && \
    apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*

COPY --from=python-builder /usr/local/bin/python* /usr/local/bin/
COPY --from=python-builder /usr/local/lib/python3.13 /usr/local/lib/python3.13
COPY --from=python-builder /usr/local/lib/libpython3.13.so* /usr/local/lib/
COPY --from=python-builder /usr/local/include/python3.13 /usr/local/include/python3.13

ENV PATH=/usr/local/bin:$PATH
# Update library cache and add library path for shared Python libraries
RUN ldconfig


ENV VIRTUAL_ENV=/app/.venv
RUN python -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ARG VERSION=v0.16.4

# Install uv
RUN wget -q https://github.com/astral-sh/uv/releases/latest/download/uv-aarch64-unknown-linux-gnu.tar.gz && \
    mkdir -p uv-extract && tar -xzf uv-aarch64-unknown-linux-gnu.tar.gz -C uv-extract && \
    cp uv-extract/uv-aarch64-unknown-linux-gnu/uv /usr/local/bin/uv && \
    cp uv-extract/uv-aarch64-unknown-linux-gnu/uvx /usr/local/bin/uvx && \
    chmod +x /usr/local/bin/uv /usr/local/bin/uvx && rm -rf uv-extract *.tar.gz

ARG TORCH_CUDA
ARG COMFY_CLI_VERSION
# Optional: copy constraints
COPY ./constraints.txt /tmp/constraints.txt
ENV UV_CONSTRAINT=/tmp/constraints.txt
ENV PIP_CONSTRAINT=/tmp/constraints.txt
ENV UV_NO_CACHE=1
ENV PIP_NO_CACHE_DIR=1

RUN uv pip install comfy-cli==${COMFY_CLI_VERSION} && \
    comfy --skip-prompt --workspace=/app/comfy install --nvidia --version $VERSION --fast-deps && \
    uv pip uninstall torch torchvision torchaudio xformers && \
    uv pip install torch torchvision torchaudio --force-reinstall --index-url https://download.pytorch.org/whl/${TORCH_CUDA}

RUN echo "Using ${TORCH_CUDA}" && \
    uv pip install --upgrade pip wheel setuptools && \
    # uv pip install xformers==0.0.32.post2 pyhocon==0.3.61 pccm==0.4.16 plotly==6.3.0 && \
    find /app -type d -name '__pycache__' -exec rm -r {} + || true

# ---------- Stage 3a: build individual wheels ----------
FROM venv-builder AS wheel-builder
ENV VIRTUAL_ENV="/app/.venv"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
ENV PYOPENGL_PLATFORM=egl
ENV FORCE_CUDA="1"
ENV CUDA_HOME="/usr/local/cuda"
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/lib/aarch64-linux-gnu:/usr/local/cuda/lib64:/usr/local/cuda/targets/aarch64-linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True,garbage_collection_threshold:0.6,max_split_size_mb:128"
ARG CUDA_ARCH_LIST
ENV TORCH_CUDA_ARCH_LIST=${CUDA_ARCH_LIST}

WORKDIR /wheels

# Build each package in separate RUN commands for better caching
RUN git clone --recursive https://github.com/ashawkey/diff-gaussian-rasterization.git && \
    cd diff-gaussian-rasterization && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

RUN git clone -b v0.2.20  --recursive https://github.com/ashawkey/kiuikit.git && \
    cd kiuikit && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

RUN git clone --recursive https://github.com/facebookresearch/pytorch3d.git && \
    cd pytorch3d && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

RUN git clone --recursive https://github.com/rusty1s/pytorch_scatter.git && \
    cd pytorch_scatter && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

RUN git clone --recursive https://github.com/NVlabs/nvdiffrast.git && \
    cd nvdiffrast && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

# RUN printf "scipy==1.16.1\nnumpy<2\n" > /req-constraints.txt

ENV MAX_JOBS=4
ARG CUDA_ARCH_LIST
ENV TORCH_CUDA_ARCH_LIST=${CUDA_ARCH_LIST}

RUN git clone --recursive https://github.com/kijai/ComfyUI-Hunyuan3DWrapper.git && \
    cd ComfyUI-Hunyuan3DWrapper && \
    git checkout cbe2837e506ffb5942fda754d0f0bccf586363a8 && \
    uv pip install pybind11==2.13.6 && \
    # pip wheel -r ComfyUI-Hunyuan3DWrapper/requirements.txt -w /wheels --no-build-isolation --no-deps && \
    pip wheel ./hy3dgen/texgen/custom_rasterizer -w /wheels --no-build-isolation --no-deps  && \
    pip wheel ./hy3dgen/texgen/differentiable_renderer -w /wheels --no-build-isolation --no-deps


# build flash-attn
RUN pip wheel flash-attn==2.8.2 -w /wheels --no-build-isolation --no-deps


ENV SPCONV_DISABLE_JIT="1"
ENV CUMM_CUDA_ARCH_LIST=${CUDA_ARCH_LIST}

ARG CUMM_CUDA_VERSION
ENV CUMM_CUDA_VERSION=${CUMM_CUDA_VERSION}
ENV CUMM_DISABLE_JIT="1"

# Build CUMM as a wheel (a dep for spconv)
COPY ./cumm_cuda_arch.patch /tmp/cumm_cuda_arch.patch
RUN git clone -b v0.7.13 https://github.com/FindDefinition/cumm.git && \
    cd cumm && \
    # Apply the CUDA architecture patch
    patch -p1 < /tmp/cumm_cuda_arch.patch && \
    echo "Applied CUDA architecture patch successfully" && \
    uv pip install -e . &&\
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/ && \
    ls -lah /wheels/cumm*whl



ARG TORCH_CUDA
ENV TORCH_CUDA=${TORCH_CUDA}

RUN git clone https://github.com/traveller59/spconv && \
    cd spconv && \
    sed -i 's/cumm-cu{}>=0.7.11, <0.8.0/cumm-cu{}>=0.7.11, <0.9.0/g' setup.py && \
    sed -i 's/cumm>=0.7.11, <0.8.0/cumm>=0.7.11, <0.9.0/g' setup.py && \
    cd .. && \
    uv pip install --no-index --find-links=/wheels --only-binary=:all: --no-deps \
     cumm_${TORCH_CUDA} && \
    # uv pip show cumm_cu128 && \
    uv pip install pccm==0.4.16 && \
    pip wheel ./spconv -w /wheels --no-build-isolation --no-deps

# build xformers without flash attention
ENV XFORMERS_DISABLE_FLASH_ATTN=1
RUN pip wheel git+https://github.com/facebookresearch/xformers.git@v0.0.32.post2 \
      -w /wheels \
      --no-build-isolation

RUN git clone --recursive https://github.com/rusty1s/pytorch_cluster.git && \
    cd pytorch_cluster && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

# Build CuMesh - CUDA mesh operations
RUN apt-get update && apt-get install -y libeigen3-dev && \
    git clone https://github.com/visualbruno/CuMesh && \
    cd CuMesh && \
    git submodule update --init --recursive && \
    mkdir -p third_party/cubvh/third_party/eigen && \
    ln -sf /usr/include/eigen3/* third_party/cubvh/third_party/eigen/ && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

# Build FlexGEMM - Flexible GEMM operations
RUN git clone --recursive https://github.com/JeffreyXiang/FlexGEMM.git && \
    cd FlexGEMM && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

# Build nvdiffrec_render - NVIDIA differentiable reconstruction renderer
RUN git clone -b renderutils https://github.com/JeffreyXiang/nvdiffrec.git && \
    cd nvdiffrec && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

# Build o_voxel - octree/voxel operations for TRELLIS
RUN git clone --recursive https://github.com/visualbruno/TRELLIS.2 && \
    cd TRELLIS.2/o-voxel && \
    python setup.py bdist_wheel && \
    cp dist/*.whl /wheels/

# Build Open3D from source because upstream has no cp313 Linux wheels yet; Trellis2 requires it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake gfortran libwayland-bin libwayland-dev libxkbcommon-dev \
        libx11-dev libxi-dev libxrandr-dev libxinerama-dev libxcursor-dev libgl1-mesa-dev libglu1-mesa-dev \
        libegl1-mesa-dev libudev-dev libusb-1.0-0-dev libssl-dev \
    && git clone --recursive https://github.com/isl-org/Open3D.git \
    && cd Open3D \
    && git checkout v0.19.0 \
    && git submodule update --init --recursive \
    && mkdir -p build \
    && cd build \
    && cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_CUDA_MODULE=OFF \
        -DBUILD_GUI=OFF \
        -DBUILD_WEBRTC=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_UNIT_TESTS=OFF \
        -DBUILD_BENCHMARKS=OFF \
        -DBUILD_PYTHON_MODULE=ON \
        -DPython3_EXECUTABLE=/app/.venv/bin/python \
    && cmake --build . --target pip-package --parallel 4 --verbose \
    && cp lib/python_package/pip_package/open3d*.whl /wheels/ \
    && apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*


# ---------- Stage 3b: install wheels  ----------
FROM venv-builder AS native-builder
ENV VIRTUAL_ENV="/app/.venv"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
ENV PYOPENGL_PLATFORM=egl
ENV FORCE_CUDA="1"
ENV CUDA_HOME="/usr/local/cuda"
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/lib/aarch64-linux-gnu:/usr/local/cuda/lib64:/usr/local/cuda/targets/aarch64-linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True,garbage_collection_threshold:0.6,max_split_size_mb:128"
ARG CUDA_ARCH_LIST
ENV TORCH_CUDA_ARCH_LIST=${CUDA_ARCH_LIST}


ENV TORCH_EXTENSIONS_DIR=/app/.venv/torch_extensions
RUN mkdir -p ${TORCH_EXTENSIONS_DIR}

# build xformers without flash attention




# Copy and install pre-built wheels
# RUN --mount=from=wheel-builder,source=/wheels,target=/mnt/wheels,ro \
#     --mount=type=cache,target=/root/.cache/pip \
#     uv pip install --no-index --find-links=/mnt/wheels --only-binary=:all: --no-deps \
#       diff_gaussian_rasterization  pytorch3d torch_scatter nvdiffrast mesh_processor custom_rasterizer nvdiffrast spconv_cu128 flash-attn



# ---------- Stage 4: ComfyUI + nodes ----------
FROM native-builder AS comfy-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libcairo2-dev && \
    apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*

# ARG CUDA_VERSION_FOR_COMFY=12.6
# ENV CUDA_VERSION_FOR_COMFY=${CUDA_VERSION_FOR_COMFY}
# ENV VERSION=${VERSION}
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# use the constraints in /app/constraints
COPY ./constraints.txt /app/constraints.txt
ENV UV_CONSTRAINT=/app/constraints.txt
ENV PIP_CONSTRAINT=/app/constraints.txt

COPY ./requirements.txt /app/requirements.txt
RUN uv pip install -r /app/requirements.txt
# install diso dependency for comfy3dpack
RUN uv pip install diso==0.1.4 --no-build-isolation

# PyPI does not publish onnxruntime-gpu wheels for Linux aarch64.  Keep ONNX-backed
# nodes usable through the supported ARM64 CPU wheel; CUDA-heavy paths use PyTorch.
RUN uv pip install onnxruntime==1.22.0 --no-build-isolation

# Install version-locked comfy nodes
COPY ./utils /app/utils
WORKDIR /app/comfy

RUN python /app/utils/node_install.py  https://github.com/rgthree/rgthree-comfy --version 0fb1e239a903e93ef626a8c20589b38f46e39dff

RUN python /app/utils/node_install.py https://github.com/kijai/ComfyUI-KJNodes --version 9d7af919b91838fb22e31ad0107a6ddcf8bd7f3f

RUN python /app/utils/node_install.py https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite --version 8e4d79471bf1952154768e8435a9300077b534fa

RUN python /app/utils/node_install.py https://github.com/Fannovel16/comfyui_controlnet_aux --version cc6b232f4a47f0cdf70f4e1bfa24b74bd0d75bf1

RUN python /app/utils/node_install.py https://github.com/kijai/ComfyUI-segment-anything-2  --version ebdb9869596b14babdaa83505e6863aad4618501

RUN python /app/utils/node_install.py https://github.com/kijai/ComfyUI-DepthAnythingV2 --version 047a4ecfd09a951944154c7f3e823566e586c2d5

RUN python /app/utils/node_install.py https://github.com/kijai/ComfyUI-WanVideoWrapper --version 2c854c53ee8c078069d9b95bf493bb44b25039ee

RUN python /app/utils/node_install.py https://github.com/Acly/comfyui-inpaint-nodes --version b9039c22de926919f26b7242cfa4da00d8b6fbec

RUN python /app/utils/node_install.py https://github.com/michaelgold/ComfyUI-HF-Model-Downloader --version 14359c49b781abfe13c0b4068fb4d5433f4b25e3

RUN python /app/utils/node_install.py https://github.com/lquesada/ComfyUI-Inpaint-CropAndStitch --version b432b2411cbb7d3192d35953bd3aafea05a0e245

# ComfyUI-3D-Pack is intentionally omitted for Python 3.13; it carries stale cp313-incompatible dependencies and is not used by current Comfy3D flows.


RUN python /app/utils/node_install.py https://github.com/cubiq/ComfyUI_essentials --version cb5c69c5715230ff6cc1402ddbb5a59473e23202

RUN python /app/utils/node_install.py https://github.com/kijai/ComfyUI-Hunyuan3DWrapper --version 4a87c71089c5d5175035bc6f0de2a586d1fd2a08

RUN python /app/utils/node_install.py https://github.com/calcuis/gguf --version e802c7831507af49eefa40324eb78378eec4f3cf


# UniRig's libigl dependency has no ARM64 wheel and builds from source. Its
# no-build-isolation path requires CMake and the PEP 517 backend.
RUN apt-get update && apt-get install -y --no-install-recommends cmake && \
    apt-get clean -y && rm -rf /var/lib/apt/lists/* && \
    uv pip install scikit-build-core

RUN python /app/utils/node_install.py https://github.com/michaelgold/ComfyUI-UniRig --version 4f2d5803dcd59ac0230623bb20871e176a1b650b --no-build-isolation

# GeometryPack builds ncollpyde and other native packages from source on
# Linux ARM64; no-build-isolation requires their backends up front. The
# point-cloud-utils 0.34.0 and pynanoinstantmeshes 0.0.3 PyPI sdists omit
# required native source files, so build the same tagged versions from their
# complete upstream repositories.
RUN uv pip install maturin puccinialin nanobind

RUN uv pip install "point-cloud-utils @ git+https://github.com/fwilliams/point-cloud-utils.git@v0.34" --no-build-isolation

# The upstream v0.0.3 repository declares its distribution metadata as
# "pynim" even though PyPI publishes the wheel as pynanoinstantmeshes.
# Its bundled legacy TBB uses declarations rejected by GCC 13's stricter
# -Wchanges-meaning handling; scope permissive compatibility to this package.
RUN CXXFLAGS="${CXXFLAGS:-} -fpermissive" uv pip install \
    "pynim @ git+https://github.com/vork/PyNanoInstantMeshes.git@v0.0.3" \
    --no-build-isolation

# ncollpyde 0.19.0 uses package.metadata.maturin fields removed in Maturin
# 0.14. Build it once with the compatible backend so GeometryPack reuses it.
# Its current transitive Rust dependencies require edition 2024, which the
# Ubuntu 24.04 distro Cargo is too old to parse. Install the official native
# rustup binary from a versioned archive and verify its published digest first.
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_SHA256="e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c"
RUN curl --fail --location --retry 3 \
        --output /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/aarch64-unknown-linux-gnu/rustup-init" && \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum --check && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y --profile minimal && \
    rm -f /tmp/rustup-init
ENV PATH="/root/.cargo/bin:${PATH}"
RUN uv pip install "maturin<0.14" && \
    uv pip install ncollpyde==0.19.0 --no-build-isolation

# Pozzetti's remeshing wheels are published for Linux x86_64 (and macOS
# arm64), but not Linux aarch64. Keep GeometryPack's portable backends and
# omit only these architecture-incompatible optional implementations.
RUN python /app/utils/node_install.py https://github.com/michaelgold/ComfyUI-GeometryPack --version 8229aa65ec026b4b87802e4ac3b28022c8dd628b --no-build-isolation \
    -i pyquadriflow -i pygeogram-ap -i pypmp -i pyquadwild -i pymesh2 -i embreex -i pynanoinstantmeshes

RUN python /app/utils/node_install.py https://github.com/visualbruno/ComfyUI-Trellis2 --version 3c7e46b265c1e28f523889ad24d65708cdeee7f8 --no-build-isolation -i open3d

RUN python /app/utils/node_install.py https://github.com/yolain/ComfyUI-Easy-Use --version b5e31ef12ad9d0b187b545c2707735cc7d581c52

RUN python /app/utils/node_install.py https://github.com/michaelgold/ComfyUI-Blender-Nodes --version a117c477762f65fe29ed51738e2e83498c43eed7

# LTXVideo imports ComfyUI Lightricks internals; keep this pin mirrored in utils/comfy3d_lockset.json.
RUN python /app/utils/node_install.py https://github.com/Lightricks/ComfyUI-LTXVideo --version 3b9c5cde4700917074823d45e25401d81049f8fc

RUN python /app/utils/node_install.py https://github.com/evanspearman/ComfyMath --version c01177221c31b8e5fbc062778fc8254aeb541638

RUN uv pip uninstall xformers

ARG TORCH_CUDA
ENV TORCH_CUDA=${TORCH_CUDA}

RUN --mount=from=wheel-builder,source=/wheels,target=/mnt/wheels,ro \
    --mount=type=cache,target=/root/.cache/pip \
    uv pip install --no-index --find-links=/mnt/wheels --only-binary=:all: --no-deps \
      diff_gaussian_rasterization  pytorch3d torch_scatter nvdiffrast mesh_processor custom_rasterizer nvdiffrast cumm_${TORCH_CUDA} spconv_${TORCH_CUDA} flash_attn xformers torch_cluster cumesh flex_gemm nvdiffrec_render o_voxel kiui open3d

# fix for older nodes
RUN uv pip install diffusers==0.34.0 transformers==4.56.0 dash plyfile

# Install Blender's dynamic runtime dependencies at the last possible cache
# boundary so adding/updating bpy does not rebuild the expensive custom nodes.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libegl1 libopengl0 libglu1-mesa libxfixes3 libxi6 \
    libxrender1 libxkbcommon0 libsm6 libxext6 libglib2.0-0 libtbbmalloc2 && \
    apt-get clean -y && rm -rf /var/lib/apt/lists/*

# Install the validated native Linux ARM64 Blender wheel from buildbpy's
# versioned release and verify its published digest before executing it. Fail
# the image build unless its ABI/runtime identity matches on aarch64.
ARG BPY_VERSION=5.2.1
ARG BPY_ARM64_WHEEL_NAME="bpy-${BPY_VERSION}-cp313-cp313-manylinux_2_39_aarch64.whl"
ARG BPY_ARM64_WHEEL="https://github.com/michaelgold/buildbpy/releases/download/v${BPY_VERSION}/${BPY_ARM64_WHEEL_NAME}"
ARG BPY_ARM64_SHA256="93ac058b264ccc847aacdb33ed460bff519dfb30f7c55fc477ca0b04ca81ff80"
RUN curl --fail --location --retry 3 --output "/tmp/${BPY_ARM64_WHEEL_NAME}" "${BPY_ARM64_WHEEL}" && \
    echo "${BPY_ARM64_SHA256}  /tmp/${BPY_ARM64_WHEEL_NAME}" | sha256sum --check && \
    uv pip install "/tmp/${BPY_ARM64_WHEEL_NAME}" && \
    rm -f "/tmp/${BPY_ARM64_WHEEL_NAME}" && \
    python -c "import bpy, platform; assert platform.machine() == 'aarch64', platform.machine(); assert bpy.app.version == (5, 2, 1), bpy.app.version; print('bpy', bpy.app.version_string, platform.machine())"



# ---------- Stage 5: final runtime ----------
ARG CUDA_PACKAGE_VERSION
FROM nvidia/cuda:${CUDA_RUNTIME_TAG} AS final
ARG CUDA_PACKAGE_VERSION

RUN apt-get update && apt-get install -y --allow-change-held-packages --no-install-recommends \
    libgl1 libegl1 libopengl0 libglu1-mesa \
    libcusparse-${CUDA_PACKAGE_VERSION} libcublas-${CUDA_PACKAGE_VERSION} libcusolver-${CUDA_PACKAGE_VERSION} \
    wget curl git gcc g++ build-essential \
    libglib2.0-0 libglib2.0-dev libgthread-2.0-0 libharfbuzz0b \
    libtbbmalloc2 \
    libvorbis-dev libtheora-dev libjpeg-dev libpng-dev libtiff-dev \
    libxfixes3 libxi6 libxrender1 libxkbcommon0 libsm6 libxext6 \
    && apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/*


# # Bring in Python runtime and venv
COPY --from=python-builder /usr/local/bin/python* /usr/local/bin/
COPY --from=python-builder /usr/local/lib/python3.13 /usr/local/lib/python3.13
COPY --from=python-builder /usr/local/lib/libpython3.13.so* /usr/local/lib/
COPY --from=python-builder /usr/local/include/python3.13 /usr/local/include/python3.13

# copy app directory from comfy-builder
COPY --from=comfy-builder /app /app


COPY ./constraints.txt /app/constraints.txt
ENV UV_CONSTRAINT=/app/constraints.txt
ENV PIP_CONSTRAINT=/app/constraints.txt



ENV PATH=/usr/local/bin:$PATH
# Update library cache and add library path for shared Python libraries
RUN ldconfig
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PYOPENGL_PLATFORM=egl
ENV FORCE_CUDA="1"
ENV CUDA_HOME="/usr/local/cuda"
ENV LD_LIBRARY_PATH="/usr/local/lib:/usr/lib/aarch64-linux-gnu:/usr/local/cuda/lib64:/usr/local/cuda/targets/aarch64-linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Open3D's ARM64 library has a static-TLS segment and must be loaded before
# Python imports other extension modules; preloading libgomp alone is insufficient.
ENV LD_PRELOAD="/app/.venv/lib/python3.13/site-packages/open3d/cpu/libOpen3D.so.0.19"
# Prevent spconv from switching algorithms at runtime

ARG CUDA_ARCH_LIST
ENV TORCH_CUDA_ARCH_LIST=${CUDA_ARCH_LIST}
ARG TORCH_CUDA
ENV TORCH_CUDA=${TORCH_CUDA}

# Version arguments for ComfyUI
ARG VERSION=v0.16.4
ARG UPDATE_VERSION=v0.16.4
ENV VERSION=${VERSION}
ENV UPDATE_VERSION=${UPDATE_VERSION}



# Set workspace and install nodes with non-interactive flags
WORKDIR /app/comfy
RUN comfy --skip-prompt --workspace=/app/comfy tracking disable

# Copy workflows/inputs, scripts
COPY ./workflows /app/comfy/user/default/workflows
COPY ./input /app/comfy/input

# Update ComfyUI to latest version if different from base, then re-sync compatibility-sensitive
# custom nodes from the checked-in lockset. This prevents a new ComfyUI core from being
# paired with stale node commits that import removed internal APIs.
RUN if [ "$VERSION" != "$UPDATE_VERSION" ] && [ -n "$UPDATE_VERSION" ]; then \
        echo "Updating ComfyUI from $VERSION to $UPDATE_VERSION"; \
        cd /app/comfy && \
        git fetch origin "$UPDATE_VERSION" && \
        git checkout --detach FETCH_HEAD && \
        uv pip install -r requirements.txt; \
    else \
        echo "No update needed, VERSION=$VERSION UPDATE_VERSION=$UPDATE_VERSION"; \
    fi && \
    python /app/utils/sync_custom_nodes_lockset.py --node ComfyUI-LTXVideo


RUN chmod a+x /app/utils/init.sh

# ENV CUDA_LAUNCH_BLOCKING=1
# ENV TORCH_SHOW_CPP_STACKTRACES=1

EXPOSE 8188
ENTRYPOINT ["/app/utils/init.sh"]
